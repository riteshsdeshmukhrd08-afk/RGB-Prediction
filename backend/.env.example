# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real .env file, and never put real keys in this example file.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=rgb_measure

# Cloudinary: use CLOUDINARY_URL ...
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ... or the three separate values (leave all empty to skip image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Website(s) allowed to call this API, comma-separated
FRONTEND_ORIGIN=http://localhost:5173

# Upload limits and number of photos measured in parallel
MAX_FILE_MB=20
MAX_FILES=200
WORKERS=2

# Folder that holds concentration_model.json (relative to backend/); only used by the linear model
MODEL_DIR=./model

# Which model gives the concentration: "ann" (default: ANN v1.1, a fixed neural network, cannot be trained)
# or "linear" (the model you train in the app from a CSV or XLSX).
MODEL_TYPE=ann
# The ANN's model file in the repository (relative to backend/). Its SHA-256 must match the value pinned in config.py.
MODEL_BUNDLE_PATH=models/ann_v1_1.joblib
